{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "monolith": {
        "ClusterId": "monolith",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "monolith": {
        "Destinations": {
          "monolith-1": { "Address": "http://localhost:5231" }
        }
      }
    }
  }
}
