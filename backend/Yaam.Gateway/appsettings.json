{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "reminders": {
        "ClusterId": "reminders",
        "Match": {
          "Path": "/api/reminders/{**catch-all}"
        }
      },
      "monolith": {
        "ClusterId": "monolith",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "reminders": {
        "Destinations": {
          "reminders-1": {
            "Address": "http://localhost:5240"
          }
        }
      },
      "monolith": {
        "Destinations": {
          "monolith-1": {
            "Address": "http://localhost:5231"
          }
        }
      }
    }
  }
}
